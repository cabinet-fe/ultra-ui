{
  "extends": "ts-conf-base/tsconfig.vue.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "types": ["vite/client"],
    "isolatedDeclarations": true,
    "lib": ["DOM", "ESNext"],
    "baseUrl": "./",
    "paths": {
      "@ui/*": ["./*"]
    },
    "erasableSyntaxOnly": true,
    "outDir": "../dist"
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.vue"],
  "exclude": ["node_modules", "**/__test__/**/*"]
}
