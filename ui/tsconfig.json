{
  "extends": "@cat-kit/tsconfig/tsconfig.vue.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "lib": ["DOM", "ESNext"],
    "baseUrl": "./",
    "paths": {
      "@ui/*": ["./*"]
    },
    "outDir": "../dist"
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.vue"],
  "exclude": ["node_modules", "**/__test__/**/*"]
}
