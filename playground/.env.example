# DeepSeek 服务端代理（server/dev.ts 读取，不会下发浏览器）
# 必填：DeepSeek API Key
DEEPSEEK_API_KEY=sk-...
# 可选：上游地址，默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：前端模型 id → 上游模型 id；缺省直接透传
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_V4_PRO_MODEL=deepseek-v4-pro

# 兼容旧配置：仅当 DEEPSEEK_API_KEY 为空时由服务端回退读取；请勿在前端代码引用
VITE_DEEPSEEK_KEY=sk-...

# report 契约 + DeepSeek 代理（bun server/dev.ts，同一端口）
REPORT_SERVER_PORT=8787
# PostgreSQL 演示数据
REPORT_DEMO_PG_URL=postgresql://user:password@127.0.0.1:5432/test
PG_SSL=false
