{
  "extends": "@cat-kit/tsconfig/tsconfig.vue.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "skipDefaultLibCheck": true,
    "customConditions": ["veltra-dev"],
    "paths": {
      "@veltra/sheet-core/*": ["../packages/sheet-core/src/*"],
      "hucre": ["../packages/sheet-core/node_modules/hucre/dist/index.d.mts"],
      "hucre/xlsx": ["../packages/sheet-core/node_modules/hucre/dist/xlsx.d.mts"],
      "hucre/csv": ["../packages/sheet-core/node_modules/hucre/dist/csv.d.mts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "env.d.ts",
    "shim.d.ts",
    "components.d.ts",
    "nav-config.ts",
    "nav-search.vue",
    "main.ts",
    "router.ts",
    "App.vue"
  ],
  "exclude": ["node_modules", "vite.config.ts"],
  "references": [
    { "path": "../packages/sheet-core/tsconfig.json" },
    { "path": "../packages/sheet-core/tsconfig.grid.json" }
  ]
}
