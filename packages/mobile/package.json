{
  "name": "@veltra/mobile",
  "version": "1.0.0",
  "homepage": "https://github.com/cabinet-fe/ultra-ui#readme",
  "bugs": {
    "url": "https://github.com/cabinet-fe/ultra-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cabinet-fe/ultra-ui",
    "directory": "packages/mobile"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "src/**/style.ts",
    "src/**/*.scss",
    "dist/**/style.js",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "veltra-dev": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "veltra-dev": "./src/*",
      "import": "./dist/*"
    }
  },
  "peerDependencies": {
    "@cat-kit/core": ">=1.2.1",
    "@veltra/compositions": "^1.8.5",
    "@veltra/icons": "^1.5.0",
    "@veltra/styles": "^1.8.5",
    "@veltra/utils": "^1.8.5",
    "vue": ">=3.5.43"
  }
}
