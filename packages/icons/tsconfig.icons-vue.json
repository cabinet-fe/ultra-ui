{
  "extends": "@cat-kit/tsconfig/tsconfig.vue.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true
  },
  "include": [
    "src/vue/**/*.vue",
    "src/env.d.ts",
    "src/normal.ts",
    "src/colorful.ts",
    "src/index.ts"
  ],
  "exclude": ["node_modules"]
}
