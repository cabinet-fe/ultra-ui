{
  "name": "@ultra-ui/styles",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "*.scss",
    "src/index.ts",
    "src/load-theme.ts",
    "src/theme/index.ts"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./normalize": {
      "sass": "./src/normalize.scss",
      "development": "./src/normalize.scss",
      "import": "./src/normalize.scss",
      "default": "./src/normalize.scss"
    },
    "./mixins": {
      "sass": "./src/_mixins.scss",
      "development": "./src/_mixins.scss",
      "import": "./src/_mixins.scss",
      "default": "./src/_mixins.scss"
    },
    "./vars": {
      "sass": "./src/_vars.scss",
      "development": "./src/_vars.scss",
      "import": "./src/_vars.scss",
      "default": "./src/_vars.scss"
    },
    "./functions": {
      "sass": "./src/_functions.scss",
      "development": "./src/_functions.scss",
      "import": "./src/_functions.scss",
      "default": "./src/_functions.scss"
    },
    "./anime/*": {
      "sass": "./src/anime/*",
      "development": "./src/anime/*",
      "import": "./src/anime/*",
      "default": "./src/anime/*"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "development": "./src/theme/index.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./*": {
      "sass": "./src/*",
      "development": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "tsdown && bun scripts/copy-scss.ts",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cat-kit/core": "^1.0.1",
    "@ultra-ui/compositions": "workspace:*",
    "@ultra-ui/utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.21.7",
    "sass-embedded": "^1.99.0",
    "tsdown": "^0.21.7"
  }
}
