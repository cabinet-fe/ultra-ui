{
  "name": "@veltra/styles",
  "version": "1.0.14",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "*.scss",
    "src/index.ts",
    "src/load-theme.ts",
    "src/theme/index.ts"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./normalize": {
      "sass": "./src/normalize.scss",
      "development": "./src/normalize.scss",
      "import": "./src/normalize.scss",
      "default": "./src/normalize.scss"
    },
    "./mixins": {
      "sass": "./src/_mixins.scss",
      "development": "./src/_mixins.scss",
      "import": "./src/_mixins.scss",
      "default": "./src/_mixins.scss"
    },
    "./vars": {
      "sass": "./src/_vars.scss",
      "development": "./src/_vars.scss",
      "import": "./src/_vars.scss",
      "default": "./src/_vars.scss"
    },
    "./functions": {
      "sass": "./src/_functions.scss",
      "development": "./src/_functions.scss",
      "import": "./src/_functions.scss",
      "default": "./src/_functions.scss"
    },
    "./anime/*": {
      "sass": "./src/anime/*",
      "development": "./src/anime/*",
      "import": "./src/anime/*",
      "default": "./src/anime/*"
    },
    "./theme": {
      "development": "./src/theme/index.ts",
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./*": {
      "sass": "./src/*",
      "development": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cat-kit/core": "^1.1.3",
    "@veltra/compositions": "workspace:*",
    "@veltra/utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.33"
  }
}
