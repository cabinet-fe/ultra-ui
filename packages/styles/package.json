{
  "name": "@veltra/styles",
  "version": "1.1.15",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "*.scss",
    "*.css",
    "src/index.ts",
    "src/load-theme.ts",
    "src/theme/index.ts"
  ],
  "exports": {
    "./anime": {
      "development": "./src/anime/index.ts",
      "import": "./dist/anime/index.js",
      "default": "./dist/anime/index.js"
    },
    "./normalize": {
      "development": "./src/normalize/index.ts",
      "import": "./dist/normalize/index.js",
      "default": "./dist/normalize/index.js"
    },
    "./theme": {
      "development": "./src/theme/index.ts",
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./*": {
      "sass": "./src/*",
      "development": "./src/*",
      "import": "./dist/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cat-kit/core": "^1.1.3",
    "@veltra/compositions": "workspace:*",
    "@veltra/utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.33"
  }
}
