{
  "name": "@veltra/styles",
  "version": "1.1.36",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "src/normalize/index.ts",
    "dist/normalize/index.js",
    "src/transitions/index.ts",
    "dist/transitions/index.js"
  ],
  "exports": {
    "./transitions": {
      "veltra-dev": "./src/transitions/index.ts",
      "import": "./dist/transitions/index.js",
      "default": "./dist/transitions/index.js"
    },
    "./normalize": {
      "veltra-dev": "./src/normalize/index.ts",
      "import": "./dist/normalize/index.js",
      "default": "./dist/normalize/index.js"
    },
    "./theme": {
      "veltra-dev": "./src/theme/index.ts",
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./*": {
      "sass": "./src/*",
      "veltra-dev": "./src/*",
      "import": "./dist/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "build": "vp pack"
  },
  "peerDependencies": {
    "@cat-kit/core": ">=1.1.6",
    "@veltra/compositions": "workspace:*",
    "@veltra/utils": "workspace:*",
    "vue": ">=3.5.0"
  }
}
