{
  "name": "@veltra/directives",
  "version": "1.1.3",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "dist/**/style.js",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "development": "./src/*",
      "types": "./dist/*",
      "import": "./dist/*"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@veltra/styles": "workspace:*",
    "@veltra/utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.33"
  }
}
