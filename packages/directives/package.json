{
  "name": "@veltra/directives",
  "version": "1.1.35",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "dist/**/style.js",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "veltra-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "veltra-dev": "./src/*",
      "types": "./dist/*",
      "import": "./dist/*"
    }
  },
  "scripts": {
    "build": "vp pack"
  },
  "peerDependencies": {
    "@veltra/styles": "workspace:*",
    "@veltra/utils": "workspace:*",
    "vue": ">=3.5.0"
  }
}
