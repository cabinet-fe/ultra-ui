{
  "name": "@veltra/ai",
  "version": "1.3.10",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "src/**/style.ts",
    "src/**/*.scss",
    "dist/**/style.js",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "veltra-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style": {
      "veltra-dev": "./src/style.ts",
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./*": {
      "veltra-dev": "./src/*",
      "types": "./dist/*",
      "import": "./dist/*"
    }
  },
  "dependencies": {
    "markstream-vue": "^1.0.8"
  },
  "peerDependencies": {
    "@veltra/compositions": "workspace:*",
    "@veltra/desktop": "workspace:*",
    "@veltra/icons": "workspace:*",
    "@veltra/styles": "workspace:*",
    "@veltra/utils": "workspace:*",
    "vue": ">=3.5.40"
  }
}
