{
  "name": "@veltra/ai",
  "version": "2.1.8",
  "homepage": "https://github.com/cabinet-fe/ultra-ui#readme",
  "bugs": {
    "url": "https://github.com/cabinet-fe/ultra-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cabinet-fe/ultra-ui",
    "directory": "packages/ai"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "src/**/style.ts",
    "src/**/*.scss",
    "dist/**/style.js",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*"
    }
  },
  "dependencies": {
    "markstream-vue": "^2.0.11"
  },
  "peerDependencies": {
    "@veltra/compositions": "^1.7.14",
    "@veltra/desktop": "^1.7.14",
    "@veltra/icons": "^1.5.0",
    "@veltra/styles": "^1.7.14",
    "@veltra/utils": "^1.7.14",
    "vue": ">=3.5.42"
  }
}
