{
  "name": "@veltra/sheet-core",
  "version": "2.6.0",
  "homepage": "https://github.com/cabinet-fe/ultra-ui#readme",
  "bugs": {
    "url": "https://github.com/cabinet-fe/ultra-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cabinet-fe/ultra-ui",
    "directory": "packages/sheet-core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "veltra-dev": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "veltra-dev": "./src/grid/index.ts",
      "import": "./dist/grid/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "veltra-dev": "./src/*",
      "import": "./dist/*"
    }
  },
  "dependencies": {
    "hucre": "^1.1.0",
    "infinitable": "^0.1.0"
  },
  "peerDependencies": {
    "@cat-kit/core": ">=1.2.1"
  }
}
