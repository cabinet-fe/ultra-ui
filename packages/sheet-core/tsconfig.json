{
  "extends": "@cat-kit/tsconfig/tsconfig.web.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true
  },
  "include": ["src/index.ts", "src/core/**/*.ts", "src/env.d.ts"],
  "exclude": ["node_modules", "src/**/__test__/**"]
}
