{
  "name": "@veltra/sheet",
  "version": "2.3.1",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "src/**/style.ts",
    "src/**/*.scss",
    "src/tools/builtin.ts",
    "dist/**/style.js",
    "dist/**/*.css",
    "dist/tools/builtin.js"
  ],
  "exports": {
    ".": {
      "veltra-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "veltra-dev": "./src/*",
      "types": "./dist/*",
      "import": "./dist/*"
    }
  },
  "dependencies": {
    "hucre": "^1.0.0"
  },
  "peerDependencies": {
    "@cat-kit/core": ">=1.1.8",
    "@cat-kit/fe": ">=1.1.8",
    "@veltra/compositions": "workspace:^",
    "@veltra/desktop": "workspace:^",
    "@veltra/icons": "workspace:^",
    "@veltra/sheet-core": "workspace:^",
    "@veltra/styles": "workspace:^",
    "@veltra/utils": "workspace:^",
    "vue": ">=3.5.41"
  }
}
