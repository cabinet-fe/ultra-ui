{
  "name": "@ultra-ui/utils",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "src/styles/**",
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "development": "./src/types/index.ts",
      "import": "./src/types/index.ts"
    },
    "./types/helper": {
      "types": "./src/types/helper.ts",
      "development": "./src/types/helper.ts",
      "import": "./src/types/helper.ts"
    },
    "./types/component-common": {
      "types": "./src/types/component-common.ts",
      "development": "./src/types/component-common.ts",
      "import": "./src/types/component-common.ts"
    },
    "./types/tip-geometry": {
      "types": "./src/types/tip-geometry.ts",
      "development": "./src/types/tip-geometry.ts",
      "import": "./src/types/tip-geometry.ts"
    },
    "./types/utils/*": {
      "types": "./src/types/utils/*",
      "development": "./src/types/utils/*",
      "import": "./src/types/utils/*"
    },
    "./types/*": {
      "types": "./src/types/*",
      "development": "./src/types/*",
      "import": "./src/types/*"
    },
    "./styles": {
      "types": "./src/styles/index.ts",
      "development": "./src/styles/index.ts",
      "import": "./src/styles/index.ts"
    },
    "./styles/theme": {
      "types": "./src/styles/theme.ts",
      "development": "./src/styles/theme.ts",
      "import": "./src/styles/theme.ts"
    },
    "./styles/*": {
      "sass": "./src/styles/*",
      "types": "./src/styles/*",
      "development": "./src/styles/*",
      "import": "./src/styles/*"
    },
    "./shared": {
      "types": "./src/shared/index.ts",
      "development": "./src/shared/index.ts",
      "import": "./src/shared/index.ts"
    },
    "./shared/*": {
      "types": "./src/shared/*",
      "development": "./src/shared/*",
      "import": "./src/shared/*"
    }
  },
  "scripts": {
    "build": "bun -e 'void 0'"
  },
  "dependencies": {
    "@cat-kit/core": "^1.0.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
