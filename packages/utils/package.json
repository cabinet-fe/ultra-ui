{
  "name": "@veltra/utils",
  "version": "1.0.7",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "development": "./src/*",
      "import": "./dist/*"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cat-kit/core": "^1.0.1"
  },
  "devDependencies": {
    "tsdown": "^0.21.7"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
