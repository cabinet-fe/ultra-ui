{
  "name": "@veltra/desktop",
  "version": "1.2.1",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "src/install.ts",
    "src/style.ts",
    "src/**/style.ts",
    "src/**/*.scss",
    "dist/install.js",
    "dist/style.js",
    "dist/**/style.js",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "veltra-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./install": {
      "veltra-dev": "./src/install.ts",
      "types": "./dist/install.d.ts",
      "import": "./dist/install.js"
    },
    "./style": {
      "veltra-dev": "./src/style.ts",
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./*": {
      "veltra-dev": "./src/*",
      "types": "./dist/*",
      "import": "./dist/*"
    }
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@embedpdf/core": "^2.14.3",
    "@embedpdf/engines": "^2.14.3",
    "@embedpdf/plugin-document-manager": "^2.14.3",
    "@embedpdf/plugin-render": "^2.14.3",
    "@embedpdf/plugin-scroll": "^2.14.3",
    "@embedpdf/plugin-viewport": "^2.14.3",
    "@embedpdf/plugin-zoom": "^2.14.1",
    "@lexical/history": "^0.45.0",
    "@lexical/html": "^0.45.0",
    "@lexical/link": "^0.45.0",
    "@lexical/list": "^0.45.0",
    "@lexical/rich-text": "^0.45.0",
    "@lexical/selection": "^0.45.0",
    "@lexical/utils": "^0.45.0",
    "@visactor/vtable": "^1.26.1",
    "codemirror": "^6.0.2",
    "docx-preview": "^0.3.7",
    "lexical": "^0.45.0"
  },
  "peerDependencies": {
    "@cat-kit/core": ">=1.1.6",
    "@cat-kit/excel": ">=1.0.0",
    "@cat-kit/fe": "^1.1.6",
    "@veltra/compositions": "workspace:*",
    "@veltra/directives": "workspace:*",
    "@veltra/icons": "workspace:*",
    "@veltra/styles": "workspace:*",
    "@veltra/utils": "workspace:*",
    "vue": ">=3.5.0"
  }
}
