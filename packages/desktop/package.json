{
  "name": "@veltra/desktop",
  "version": "1.12.1",
  "homepage": "https://github.com/cabinet-fe/ultra-ui#readme",
  "bugs": {
    "url": "https://github.com/cabinet-fe/ultra-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cabinet-fe/ultra-ui",
    "directory": "packages/desktop"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "src/install.ts",
    "src/style.ts",
    "src/**/style.ts",
    "src/**/*.scss",
    "src/**/pdf-polyfill.ts",
    "src/**/pdf-worker-wrapper.ts",
    "dist/install.js",
    "dist/style.js",
    "dist/**/style.js",
    "dist/**/*.css",
    "dist/**/pdf-polyfill.js",
    "dist/**/pdf-worker-wrapper.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "veltra-dev": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./install": {
      "types": "./dist/install.d.ts",
      "veltra-dev": "./src/install.ts",
      "import": "./dist/install.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "veltra-dev": "./src/style.ts",
      "import": "./dist/style.js"
    },
    "./*": {
      "types": "./dist/*",
      "veltra-dev": "./src/*",
      "import": "./dist/*"
    }
  },
  "dependencies": {
    "@lexical/history": "^0.52.0",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "docx-preview": "^0.4.1",
    "infinitable": "^0.2.1",
    "lexical": "^0.52.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "@veltra/ofd-core": "workspace:*"
  },
  "peerDependencies": {
    "@cat-kit/core": ">=1.2.1",
    "@cat-kit/fe": ">=1.2.1",
    "@veltra/compositions": "^1.7.14",
    "@veltra/directives": "^1.7.14",
    "@veltra/icons": "^1.5.0",
    "@veltra/styles": "^1.7.14",
    "@veltra/utils": "^1.7.14",
    "vue": ">=3.5.43"
  }
}
