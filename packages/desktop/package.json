{
  "name": "@ultra-ui/desktop",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "src/components/**/style.ts",
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./install": {
      "types": "./dist/install.d.ts",
      "development": "./src/install.ts",
      "import": "./dist/install.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "development": "./src/*",
      "import": "./dist/*.js"
    }
  },
  "dependencies": {
    "@cat-kit/core": "^1.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@floating-ui/dom": "^1.7.6",
    "@lexical/clipboard": "^0.42.0",
    "@lexical/history": "^0.42.0",
    "@lexical/html": "^0.42.0",
    "@lexical/link": "^0.42.0",
    "@lexical/list": "^0.42.0",
    "@lexical/rich-text": "^0.42.0",
    "@lexical/selection": "^0.42.0",
    "@lexical/utils": "^0.42.0",
    "@tanstack/vue-virtual": "^3.13.23",
    "@ultra-ui/compositions": "workspace:*",
    "@ultra-ui/directives": "workspace:*",
    "@ultra-ui/icons": "workspace:*",
    "@ultra-ui/utils": "workspace:*",
    "codemirror": "^6.0.2",
    "lexical": "^0.42.0"
  },
  "peerDependencies": {
    "@ultra-ui/icons": "workspace:*",
    "vue": "^3.5.0"
  }
}
