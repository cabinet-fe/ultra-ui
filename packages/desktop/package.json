{
  "name": "@veltra/desktop",
  "version": "1.0.9",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "dist/**/style.js",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "development": "./src/*",
      "types": "./dist/*",
      "import": "./dist/*"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cat-kit/core": "^1.1.3",
    "@cat-kit/excel": "^1.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@embedpdf/core": "^2.14.1",
    "@embedpdf/engines": "^2.14.1",
    "@embedpdf/plugin-document-manager": "^2.14.1",
    "@embedpdf/plugin-render": "^2.14.1",
    "@embedpdf/plugin-scroll": "^2.14.1",
    "@embedpdf/plugin-viewport": "^2.14.1",
    "@lexical/clipboard": "^0.43.0",
    "@lexical/history": "^0.43.0",
    "@lexical/html": "^0.43.0",
    "@lexical/link": "^0.43.0",
    "@lexical/list": "^0.43.0",
    "@lexical/rich-text": "^0.43.0",
    "@lexical/selection": "^0.43.0",
    "@lexical/utils": "^0.43.0",
    "@veltra/compositions": "workspace:*",
    "@veltra/directives": "workspace:*",
    "@veltra/icons": "workspace:*",
    "@veltra/styles": "workspace:*",
    "@veltra/utils": "workspace:*",
    "@visactor/vtable": "^1.26.0",
    "codemirror": "^6.0.2",
    "docx-preview": "^0.3.7",
    "lexical": "^0.43.0"
  },
  "peerDependencies": {
    "@veltra/compositions": "workspace:*",
    "@veltra/directives": "workspace:*",
    "@veltra/icons": "workspace:*",
    "@veltra/styles": "workspace:*",
    "@veltra/utils": "workspace:*",
    "vue": "^3.5.33"
  }
}
