{
  "name": "@veltra/desktop",
  "version": "1.0.7",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "dist/**/style.js",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "development": "./src/*",
      "import": "./dist/*"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cat-kit/core": "^1.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@lexical/clipboard": "^0.42.0",
    "@lexical/history": "^0.42.0",
    "@lexical/html": "^0.42.0",
    "@lexical/link": "^0.42.0",
    "@lexical/list": "^0.42.0",
    "@lexical/rich-text": "^0.42.0",
    "@lexical/selection": "^0.42.0",
    "@lexical/utils": "^0.42.0",
    "@veltra/compositions": "workspace:*",
    "@veltra/directives": "workspace:*",
    "@veltra/icons": "workspace:*",
    "@veltra/styles": "workspace:*",
    "@veltra/utils": "workspace:*",
    "codemirror": "^6.0.2",
    "lexical": "^0.42.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.21.7",
    "sass-embedded": "^1.99.0",
    "tsdown": "^0.21.7",
    "unplugin-vue": "^7.1.1",
    "unplugin-vue-jsx": "^0.8.1",
    "vue-tsc": "^3.2.6"
  },
  "peerDependencies": {
    "@veltra/compositions": "workspace:*",
    "@veltra/directives": "workspace:*",
    "@veltra/icons": "workspace:*",
    "@veltra/styles": "workspace:*",
    "@veltra/utils": "workspace:*",
    "vue": "^3.5.0"
  }
}
