{
  "extends": "@cat-kit/tsconfig/tsconfig.vue.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "skipDefaultLibCheck": true,
    "customConditions": ["development"],
    "paths": {
      "@cat-kit/core": ["../../node_modules/@cat-kit/core/dist/index.d.ts"],
      "@cat-kit/fe": ["../../node_modules/@cat-kit/fe/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "*.d.ts", "*.ts"],
  "exclude": ["node_modules", "vite.config.ts"]
}
