{
  "extends": "@cat-kit/tsconfig/tsconfig.bun.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "customConditions": ["veltra-dev"]
  },
  "include": [
    "vite.config.ts",
    "packages/*/vite.config.ts",
    "playgrounds/desktop/vite.config.ts",
    "playgrounds/icons/vite.config.ts",
    "scripts/*.ts",
    "packages/icons/scripts/*.ts"
  ]
}
