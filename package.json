{
  "name": "veltra",
  "private": true,
  "keywords": [
    "Vue",
    "Vue UI",
    "Vue3",
    "Vue组件",
    "前端框架",
    "完全TS开发的Vue3组件库"
  ],
  "homepage": "https://github.com/cabinet-fe/ultra-ui#readme",
  "bugs": {
    "url": "https://github.com/cabinet-fe/ultra-ui/issues"
  },
  "author": "cabinet-fe",
  "repository": {
    "type": "git",
    "url": "https://github.com/cabinet-fe/ultra-ui"
  },
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run --concurrency-limit 2 -r build",
    "build:packages": "vp run --concurrency-limit 2 --filter '@veltra/*' build",
    "ci:verify": "bun run resolver:gen -- --check && vp run --concurrency-limit 2 --filter '@veltra/*' build && vp lint && vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "dev": "vp run -r dev",
    "test": "vp test",
    "test:changed": "bun scripts/test-changed.ts",
    "postinstall": "vp config --no-agent && bun run scripts/setup-git.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run scripts/release.ts",
    "resolver:gen": "bun run scripts/gen-vite-resolver.ts"
  },
  "devDependencies": {
    "@cat-kit/cli": "^1.0.6",
    "@cat-kit/tsconfig": "^2.0.1",
    "@changesets/cli": "^3.0.3",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "happy-dom": "^20.14.6",
    "sass-embedded": "1.105.2",
    "typescript": "^6.0.3",
    "unplugin-vue": "^8.0.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-jsx": "^0.10.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.44"
  },
  "overrides": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "vite": "catalog:"
  },
  "simple-git-hooks": {
    "commit-msg": "bun cat-cli verify-commit",
    "pre-commit": "vp staged"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  }
}
