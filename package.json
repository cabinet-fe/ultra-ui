{
  "name": "veltra",
  "private": true,
  "keywords": [
    "Vue",
    "Vue UI",
    "Vue3",
    "Vue组件",
    "前端框架",
    "完全TS开发的Vue3组件库"
  ],
  "author": "cabinet-fe",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "build:packages": "vp run --filter '@veltra/*' --filter '!@veltra/mobile' build",
    "ci:verify": "vp lint && vp run --filter '@veltra/*' --filter '!@veltra/mobile' build && vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "dev": "vp run -r dev",
    "test": "vp test",
    "update": "bun update",
    "postinstall": "simple-git-hooks && bun run scripts/setup-git.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run scripts/release.ts",
    "skill:gen": "bun run scripts/gen-veltra-skill.ts"
  },
  "devDependencies": {
    "@cat-kit/cli": "^1.0.6",
    "@cat-kit/tsconfig": "^2.0.1",
    "@changesets/cli": "^2.31.1",
    "@tsdown/css": "0.22.13",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "happy-dom": "^20.11.1",
    "sass-embedded": "1.100.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "unplugin-vue": "^7.2.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-jsx": "^0.10.0",
    "vite-plus": "0.2.5",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.9"
  },
  "simple-git-hooks": {
    "commit-msg": "bun cat-cli verify-commit",
    "pre-commit": "vp staged"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.4"
  }
}
