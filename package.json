{
  "name": "ultra",
  "private": true,
  "keywords": [
    "Vue",
    "Vue UI",
    "Vue3",
    "Vue组件",
    "前端框架",
    "完全TS开发的Vue3组件库"
  ],
  "author": "cabinet-fe",
  "workspaces": [
    "packages/*",
    "playgrounds/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter='./packages/*'",
    "dev": "turbo run dev",
    "test": "vitest --run",
    "gen": "bun tools/cli/gen-component/index.ts",
    "export": "bun tools/cli/export/index.ts",
    "rename:types": "bun tools/cli/rename/types",
    "update": "bun update",
    "postinstall": "simple-git-hooks",
    "lint": "oxlint .",
    "format": "oxfmt ."
  },
  "devDependencies": {
    "@cat-kit/cli": "^1.0.3",
    "@cat-kit/tsconfig": "^2.0.1",
    "@types/bun": "^1.3.11",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "fast-glob": "^3.3.3",
    "lint-staged": "^16.2.7",
    "vite": "^8.0.8",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.9.5",
    "typescript": "^6.0.2",
    "vite-plugin-inspect": "^12.0.0-beta.1",
    "vitest": "^4.1.3",
    "vue": "^3.5.32"
  },
  "simple-git-hooks": {
    "commit-msg": "bun cat-cli verify-commit",
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,jsx}": ["oxlint", "oxfmt --write"]
  },
  "packageManager": "bun@1.3.11",
  "overrides": {
    "@codemirror/autocomplete": "6.20.0",
    "@codemirror/commands": "6.10.1",
    "@codemirror/language": "6.12.1",
    "@codemirror/lint": "6.9.2",
    "@codemirror/search": "6.6.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.41.0"
  }
}
