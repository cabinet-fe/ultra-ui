{
  "name": "ultra",
  "overrides": {
    "estree-walker": "2.0.2"
  },
  "keywords": [
    "Vue",
    "Vue UI",
    "Vue3",
    "Vue组件",
    "前端框架",
    "完全TS开发的Vue3组件库"
  ],
  "author": "cabinet-fe",
  "workspaces": [
    "packages/*",
    "sample",
    "cli",
    "build"
  ],
  "type": "module",
  "scripts": {
    "gen": "bun cli/gen-component/index.ts",
    "export": "bun cli/export/index.ts",
    "gen:pc-install-registry": "bun run cli/gen-pc-install-registry.ts",
    "rename:types": "bun cli/rename/types",
    "sync-use-cat-kit-api": "bun .agents/skills/use-cat-kit/scripts/sync-api-from-dist.ts",
    "typecheck:sample": "bun run --cwd sample typecheck",
    "update": "bun update",
    "postinstall": "simple-git-hooks"
  },
  "devDependencies": {
    "@cat-kit/cli": "^1.0.3",
    "@cat-kit/tsconfig": "^2.0.0",
    "@types/bun": "^1.3.11",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6.0.5",
    "fast-glob": "^3.3.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "6.0.2",
    "vite-plugin-inspect": "^11.3.3",
    "vitest": "^4.1.2",
    "vue": "^3.5.32"
  },
  "simple-git-hooks": {
    "commit-msg": "bun cat-cli verify-commit"
  }
}
