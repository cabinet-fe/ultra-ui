{
  "name": "ultra",
  "private": true,
  "keywords": [
    "Vue",
    "Vue UI",
    "Vue3",
    "Vue组件",
    "前端框架",
    "完全TS开发的Vue3组件库"
  ],
  "author": "cabinet-fe",
  "workspaces": [
    "packages/*",
    "playgrounds/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "gen": "bun tools/cli/gen-component/index.ts",
    "export": "bun tools/cli/export/index.ts",
    "rename:types": "bun tools/cli/rename/types",
    "update": "bun update",
    "postinstall": "simple-git-hooks",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='@ultra-ui/*' --filter='!@ultra-ui/mobile' && changeset publish"
  },
  "devDependencies": {
    "@cat-kit/cli": "^1.0.3",
    "@cat-kit/tsconfig": "^2.0.1",
    "@changesets/cli": "^2.30.0",
    "@tsdown/css": "^0.21.7",
    "@types/bun": "^1.3.11",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "fast-glob": "^3.3.3",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "sass-embedded": "^1.99.0",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.21.7",
    "turbo": "^2.9.5",
    "typescript": "^6.0.2",
    "unplugin-vue": "^7.1.1",
    "unplugin-vue-jsx": "^0.8.1",
    "vite": "^8.0.8",
    "vite-plugin-inspect": "^12.0.0-beta.1",
    "vitest": "^4.1.3",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.6"
  },
  "overrides": {
    "@codemirror/autocomplete": "6.20.0",
    "@codemirror/commands": "6.10.1",
    "@codemirror/language": "6.12.1",
    "@codemirror/lint": "6.9.2",
    "@codemirror/search": "6.6.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.41.0"
  },
  "simple-git-hooks": {
    "commit-msg": "bun cat-cli verify-commit",
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,jsx}": [
      "oxlint",
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.3.11"
}
