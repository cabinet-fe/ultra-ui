  "workspaces": [
    "sample",
    "cli",
    "build",
    "ui"
  ],
  "devDependencies": {
    "@types/bun": "^1.2.20",
    "cat-kit": "^3.7.13",
    "fast-glob": "^3.3.3",
    "@ultra/icon": "^1.0.0",
    "rollup": "4.34.8",
    "rollup-plugin-esbuild": "^6.2.1",
    "sass-embedded": "^1.90.0",
    "simple-git-hooks": "^2.13.1",
    "ts-conf-base": "^2.4.2",
    "typescript": "5.9.2",
    "vite": "npm:rolldown-vite@^7.1.0",
    "vitest": "^3.2.4",
    "vue": "3.5.18",
    "vue-router": "^4.5.1",
    "vue-tsc": "3.1.1",
    "@builder/cli": "^3.0.0",
    "tsx": "^4.20.3"
